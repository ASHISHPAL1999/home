apiVersion: v1
kind: Service
metadata:
  name: demotomcat
  namespace: default
  labels:
    app: demotomcat-appsec
spec:
  type: ClusterIP   # internal-only, perfect for private AKS
  selector:
    app: demotomcat-
  ports:
    - name: http
      port: 8080
      targetPort: 8080
      protocol: TCP
